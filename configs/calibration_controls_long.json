{
  "description": "Twenty-epoch A0-L/A2-L controls on CDD-11-30.",
  "control_note": "Matches A3-L's duration, seed, optimization schedule, and full-frame PSNR evaluation; A0-L is the NAFNet baseline and A2-L adds the bottleneck adapter with skip gates, with every auxiliary loss disabled.",
  "shared": {
    "preset": "sidd32",
    "pretrained": "auto",
    "adapter_hidden": 64,
    "seed": 42,
    "crop_size": 256,
    "val_crop_size": 0,
    "epochs": 20,
    "max_minutes": 0,
    "batch_size": 4,
    "microbatch_size": 2,
    "patches_per_image": 2,
    "num_workers": 0,
    "pin_memory": false,
    "save_optimizer": false,
    "learning_rate": 0.0002,
    "backbone_lr_scale": 1.0,
    "weight_decay": 0.001,
    "fft_weight": 0.05,
    "freeze_backbone_epochs": 0,
    "amp": true,
    "evaluation_tile": 0,
    "evaluation_num_workers": 0,
    "save_evaluation_images": true,
    "save_comparisons": true,
    "max_saved_per_type": 1,
    "evaluate_reasoning_checkpoint": false
  },
  "runs": [
    {
      "name": "a0l_nafnet_baseline_sidd32_seed42_20ep",
      "model": "baseline",
      "skip_gates": false,
      "degradation_weight": 0.0,
      "content_weight": 0.0,
      "decorrelation_weight": 0.0,
      "gate_weight": 0.0
    },
    {
      "name": "a2l_bottleneck_skip_sidd32_seed42_20ep",
      "model": "hybrid",
      "skip_gates": true,
      "degradation_weight": 0.0,
      "content_weight": 0.0,
      "decorrelation_weight": 0.0,
      "gate_weight": 0.0
    }
  ]
}
